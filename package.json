{
  "name": "tala-speech",
  "version": "2.19.0",
  "author": "Talkamatic AB",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Talkamatic/tala-speech"
  },
  "license": "GPL-3.0",
  "scripts": {
    "test": "vitest run",
    "compile": "tsc --outDir dist/lib",
    "esbuild:serve": "esbuild src/index.ts --bundle --serve=localhost:4200 --servedir=. --outdir=dist/browser --watch",
    "esbuild:bundle": "esbuild src/index.ts --bundle --minify --outdir=dist/browser",
    "tailwind": "tailwindcss -i ./src/input.css -o ./src/index.css",
    "serve": "npm-run-all --parallel \"tailwind --watch\" esbuild:serve",
    "build": "npm-run-all  tailwind esbuild:bundle"
  },
  "dependencies": {
    "speechstate": "^2.17.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "esbuild": "^0.25.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3",
    "typescript-language-server": "^4.3.1"
  }
}
